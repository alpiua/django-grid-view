{
  "name": "grid-view-spec-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-ag-grid-vendor.mjs && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint src",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:types:check": "node scripts/gen-types.mjs --check",
    "build:conformance": "node scripts/build-conformance.mjs",
    "test:conformance": "npm run build:conformance && node scripts/run-conformance.mjs",
    "build:chart-conformance": "node scripts/build-chart-conformance.mjs",
    "test:chart-conformance": "npm run build:chart-conformance && node scripts/run-chart-conformance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "ag-grid-community": "31.3.4",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
