{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextunity.dev/schema/grid-view-spec.v2.json",
  "title": "GridViewSpec v2",
  "description": "Flat blocks/layout contract for grid-view-spec 2.x. Host supplies rows separately.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": { "type": "string" },
    "meta": { "$ref": "#/$defs/GridViewMeta" },
    "config": { "$ref": "#/$defs/GridViewConfig" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/GridViewBlock" }
    },
    "layout": { "$ref": "#/$defs/GridViewLayout" }
  },
  "$defs": {
    "JsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        },
        { "type": "array", "items": { "$ref": "#/$defs/JsonValue" } }
      ]
    },
    "GridViewMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "GridViewLazyDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "method": { "enum": ["get", "post"], "default": "get" },
        "placeholder": {
          "enum": ["skeleton", "spinner", "empty"],
          "default": "skeleton"
        },
        "mode": {
          "enum": ["replace", "merge", "append"],
          "default": "replace"
        },
        "timeout_ms": { "type": "integer", "default": 30000 }
      }
    },
    "GridViewConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "htmx": { "type": "boolean", "default": true },
        "template": { "type": "string" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewTemplateAsset" }
        },
        "lazy": { "$ref": "#/$defs/GridViewLazyDefaults" }
      }
    },
    "GridViewTrustedStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css_vars": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "GridViewStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "enum": ["", "auto", "full", "content"] },
        "min_width": { "type": "string" },
        "height": { "type": "string" },
        "min_height": { "type": "string" },
        "overflow": { "enum": ["", "visible", "hidden", "auto"] },
        "padding": { "enum": ["", "none", "xs", "sm", "md", "lg"] },
        "gap": { "enum": ["", "none", "xs", "sm", "md", "lg"] },
        "tone": {
          "enum": [
            "",
            "default",
            "muted",
            "primary",
            "success",
            "warning",
            "danger"
          ]
        },
        "surface": { "enum": ["", "none", "plain", "card", "panel"] },
        "sticky": { "enum": ["", "top", "bottom"] }
      }
    },
    "GridViewLazyBlock": {
      "type": "object",
      "required": ["endpoint"],
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string" },
        "trigger": {
          "enum": ["load", "visible", "manual"],
          "default": "visible"
        },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        },
        "method": { "enum": ["get", "post"] },
        "placeholder": { "enum": ["skeleton", "spinner", "empty"] },
        "mode": { "enum": ["replace", "merge", "append"] },
        "timeout_ms": { "type": "integer" }
      }
    },
    "GridViewBlockBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "extra": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        },
        "style": { "$ref": "#/$defs/GridViewStyle" },
        "trusted_style": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/GridViewTrustedStyle" }
          ]
        },
        "lazy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/GridViewLazyBlock" }]
        }
      }
    },
    "GridViewBlock": {
      "oneOf": [
        { "$ref": "#/$defs/GridViewHeader" },
        { "$ref": "#/$defs/GridViewToolbar" },
        { "$ref": "#/$defs/GridViewFilters" },
        { "$ref": "#/$defs/GridViewActions" },
        { "$ref": "#/$defs/GridViewTable" },
        { "$ref": "#/$defs/GridViewCharts" },
        { "$ref": "#/$defs/GridViewKpi" },
        { "$ref": "#/$defs/GridViewCards" },
        { "$ref": "#/$defs/GridViewCardGroups" },
        { "$ref": "#/$defs/GridViewGallery" },
        { "$ref": "#/$defs/GridViewImage" },
        { "$ref": "#/$defs/GridViewTabs" },
        { "$ref": "#/$defs/GridViewNav" },
        { "$ref": "#/$defs/GridViewContent" },
        { "$ref": "#/$defs/GridViewForm" },
        { "$ref": "#/$defs/GridViewOverlay" },
        { "$ref": "#/$defs/GridViewTemplate" }
      ]
    },
    "GridViewHeader": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "header" },
            "presentation": {
              "enum": ["plain", "entity", "split", "compact", "hero", "section"]
            },
            "nav": { "type": ["string", "null"] },
            "entity": {
              "oneOf": [{ "type": "null" }, { "type": "object" }]
            },
            "content": { "type": ["string", "null"] },
            "subtitle": { "type": "string" },
            "icon": { "type": "string" },
            "actions": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "GridViewCounter": {
      "type": "object",
      "required": ["id", "label", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": ["string", "integer", "number"] },
        "tone": { "enum": ["", "muted", "success", "warning", "danger"] },
        "field": { "type": ["string", "null"] },
        "total": { "type": ["integer", "null"] },
        "server_only": { "type": "boolean" }
      }
    },
    "GridViewToolbar": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "toolbar" },
            "presentation": { "enum": ["default", "compact", "panel"] },
            "search": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/GridViewSearch" }
              ]
            },
            "filters": { "type": ["string", "null"] },
            "clear_all": { "type": "boolean" },
            "reload": { "type": "boolean" },
            "counters": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewCounter" }
            },
            "actions": { "type": ["string", "null"] },
            "target": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "GridViewSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "param": { "type": "string", "default": "q" },
        "value": { "type": "string" },
        "placeholder": { "type": "string" },
        "backend": {
          "enum": ["server", "ag_grid", "client"],
          "default": "server"
        },
        "mode": { "enum": ["simple", "smart"], "default": "smart" },
        "bind": { "type": ["string", "null"] },
        "saved": { "type": "boolean", "default": true },
        "compact": { "type": "boolean", "default": true }
      }
    },
    "GridViewFilter": {
      "type": "object",
      "required": ["id", "label", "param", "type"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "param": { "type": "string" },
        "type": {
          "enum": [
            "text",
            "number",
            "number_range",
            "select",
            "multiselect",
            "set",
            "date",
            "date_range",
            "boolean"
          ]
        },
        "scope": { "enum": ["server", "client"], "default": "server" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewFilterOption" }
        },
        "options_endpoint": { "type": "string" },
        "placeholder": { "type": "string" },
        "select_all": { "type": "boolean" },
        "select_all_label": { "type": "string" },
        "select_all_value": { "type": "string" },
        "all_exclusive": { "type": "boolean" },
        "presets": { "type": "object" },
        "default": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "SetFilterModel": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "match"],
          "properties": {
            "mode": { "enum": ["empty", "non_empty"] },
            "match": {
              "enum": ["exact", "any_token"]
            }
          }
        },
        {
          "type": "object",
          "required": ["values", "match"],
          "properties": {
            "values": { "type": "array", "items": { "type": "string" } },
            "match": {
              "enum": ["exact", "any_token"]
            }
          }
        }
      ]
    },
    "GridViewFilterOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewFilterOption" }
        },
        "exclusive": { "type": "boolean" },
        "meta": { "type": "object" },
        "count": { "type": ["integer", "null"] },
        "disabled": { "type": "boolean" }
      }
    },
    "GridViewFilters": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "filters" },
            "presentation": {
              "enum": ["toolbar", "inline", "panel", "drawer"]
            },
            "schema": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewFilter" }
            },
            "state": { "type": "object" },
            "target": { "type": ["string", "null"] },
            "auto_apply": { "type": "boolean", "default": true },
            "navigate_on_change": { "type": "boolean", "default": true },
            "facets": { "type": "boolean", "default": false },
            "fragment_endpoint": { "type": "string" },
            "fragment_target": { "type": "string" },
            "fragment_swap": { "type": "string", "default": "outerHTML" }
          }
        }
      ]
    },
    "GridViewTablePagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer" },
        "page_size": { "type": "integer" },
        "total": { "type": "integer" },
        "mode": { "enum": ["server", "client", "fragment"] },
        "page_param": { "type": "string" },
        "page_size_param": { "type": "string" },
        "fragment_endpoint": { "type": "string" },
        "fragment_target": { "type": "string" },
        "fragment_swap": { "type": "string" },
        "page_endpoint": { "type": "string" },
        "page_size_options": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "GridViewTable": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "table" },
            "backend": { "enum": ["simple", "ag_grid"], "default": "simple" },
            "columns": { "type": "array" },
            "column_source": {
              "oneOf": [{ "type": "null" }, { "type": "object" }]
            },
            "rows": { "type": "array" },
            "datasource": {
              "oneOf": [{ "type": "null" }, { "type": "object" }]
            },
            "header": { "type": "object" },
            "search_mode": {
              "enum": ["global", "per_column", "disabled"],
              "default": "global"
            },
            "sort": { "type": "object" },
            "settings": { "oneOf": [{ "type": "null" }, { "type": "object" }] },
            "edit": { "oneOf": [{ "type": "null" }, { "type": "object" }] },
            "assets": { "type": "array" },
            "row_action": {
              "oneOf": [{ "type": "null" }, { "type": "object" }]
            },
            "footer": { "oneOf": [{ "type": "null" }, { "type": "object" }] },
            "empty_message": { "type": "string" },
            "per_page": { "type": "integer" },
            "pagination": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/GridViewTablePagination" }
              ]
            },
            "striped": { "type": "boolean" }
          }
        }
      ]
    },
    "GridViewCharts": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["charts"],
          "properties": {
            "type": { "const": "charts" },
            "charts": { "type": "array" },
            "presentation": { "enum": ["grid", "stack", "tabs", "single"] },
            "filters": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "GridViewChartOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "series": { "type": "array" },
        "label_key": { "type": "string" },
        "value_key": { "type": "string" },
        "group_by": { "type": "string" },
        "aggregate": { "type": "string" },
        "height": { "type": "integer" },
        "orientation": { "enum": ["vertical", "horizontal"] },
        "stacked": { "type": "boolean" },
        "data_source": { "enum": ["static", "grid_filtered"] },
        "overlay": { "type": "object" },
        "pie_variant": { "type": "string" },
        "tooltip_kind": { "type": "string" },
        "y_axis_format": { "type": "string" },
        "y_axis_symbol": { "type": "string" },
        "echarts_theme": { "type": "string" }
      }
    },
    "GridViewKpi": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["items"],
          "properties": {
            "type": { "const": "kpi" },
            "items": { "type": "array" },
            "presentation": { "enum": ["strip", "cards", "compact"] }
          }
        }
      ]
    },
    "GridViewCards": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["cards"],
          "properties": {
            "type": { "const": "cards" },
            "cards": { "type": "array" },
            "presentation": { "enum": ["list", "grid", "tiles", "panel"] }
          }
        }
      ]
    },
    "GridViewCardGroup": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "tone": {
          "enum": ["default", "muted", "success", "warning", "danger"]
        },
        "items": { "type": "array", "items": { "type": "string" } },
        "count": { "type": ["string", "integer"] },
        "empty_message": { "type": "string" }
      }
    },
    "GridViewCardGroups": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "card_groups" },
            "groups": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewCardGroup" }
            }
          }
        }
      ]
    },
    "GridViewGallery": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "gallery" },
            "presentation": {
              "enum": ["grid", "carousel", "masonry", "filmstrip"]
            }
          }
        }
      ]
    },
    "GridViewImage": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["image"],
          "properties": {
            "type": { "const": "image" },
            "image": { "type": "object" },
            "fit": { "enum": ["cover", "contain", "fill"] }
          }
        }
      ]
    },
    "GridViewTabs": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["tabs"],
          "properties": {
            "type": { "const": "tabs" },
            "tabs": { "type": "array" },
            "presentation": { "enum": ["tabs", "segmented", "pills"] }
          }
        }
      ]
    },
    "GridViewNav": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "required": ["items"],
          "properties": {
            "type": { "const": "nav" },
            "items": { "type": "array" },
            "presentation": {
              "enum": ["breadcrumbs", "tabs", "sidebar", "menu", "back"]
            }
          }
        }
      ]
    },
    "GridViewContent": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "content" },
            "role": {
              "enum": [
                "text",
                "info",
                "formula",
                "empty",
                "warning",
                "callout",
                "banner"
              ]
            },
            "body": { "type": "string" },
            "tone": {
              "enum": ["", "default", "info", "success", "warning", "danger"]
            },
            "dismissible": { "type": "boolean" }
          }
        }
      ]
    },
    "GridViewValidator": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "required",
            "email",
            "url",
            "number",
            "integer",
            "min",
            "max",
            "min_length",
            "max_length",
            "pattern",
            "domain",
            "custom"
          ]
        },
        "value": { "type": ["string", "integer", "number", "null"] },
        "message": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "GridViewFieldCondition": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "equals": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "GridViewField": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "select",
            "multiselect",
            "date",
            "date_range",
            "boolean",
            "file"
          ]
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewFilterOption" }
        },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/JsonValue" },
        "placeholder": { "type": "string" },
        "help": { "type": "string" },
        "validators": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewValidator" }
        },
        "visible_when": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/GridViewFieldCondition" }
          ]
        },
        "extra": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      }
    },
    "GridViewFieldset": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "columns": { "type": "integer" }
      }
    },
    "GridViewForm": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "form" },
            "presentation": { "enum": ["stack", "inline", "grid", "panel"] },
            "fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewField" }
            },
            "fieldsets": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewFieldset" }
            },
            "values": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/JsonValue" }
            },
            "errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "submit": { "oneOf": [{ "type": "null" }, { "type": "object" }] },
            "endpoint": { "type": "string" },
            "method": { "enum": ["get", "post"] }
          }
        }
      ]
    },
    "GridViewOverlay": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "overlay" },
            "presentation": { "enum": ["modal", "drawer", "popover"] },
            "spec": { "$ref": "#" },
            "content": { "type": ["string", "null"] },
            "size": { "enum": ["sm", "md", "lg", "xl", "fullscreen"] }
          }
        }
      ]
    },
    "GridViewTemplate": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "template" },
            "mode": { "enum": ["file", "raw"] },
            "template": { "type": "string" },
            "context": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/JsonValue" }
            },
            "html": { "type": "string" },
            "assets": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridViewTemplateAsset" }
            }
          }
        }
      ]
    },
    "GridViewActions": {
      "allOf": [
        { "$ref": "#/$defs/GridViewBlockBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "actions" },
            "presentation": { "enum": ["inline", "menu", "split", "compact"] },
            "items": { "type": "array" }
          }
        }
      ]
    },
    "GridViewTemplateAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["script", "style", "module"] },
        "src": { "type": "string" },
        "defer": { "type": "boolean" },
        "module": { "type": "boolean" }
      }
    },
    "GridViewArea": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "stack",
            "grid",
            "sidebar",
            "split",
            "tabs",
            "modal",
            "table-card"
          ],
          "default": "stack"
        },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "areas": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridViewArea" }
        },
        "style": { "$ref": "#/$defs/GridViewStyle" },
        "extra": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      }
    },
    "GridViewLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "$ref": "#/$defs/GridViewArea" }
      }
    },
    "GridViewLazyResponse": {
      "type": "object",
      "required": ["block_id"],
      "additionalProperties": false,
      "properties": {
        "block_id": { "type": "string" },
        "state": { "enum": ["loaded", "empty", "error"], "default": "loaded" },
        "html": { "type": "string" },
        "block": { "$ref": "#/$defs/GridViewBlock" },
        "spec": { "$ref": "#" },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        },
        "error": { "type": "string" },
        "next_cursor": { "type": "string" }
      }
    },
    "A2UIPatchOp": {
      "type": "object",
      "required": ["op", "block_id"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add_block",
            "update_block",
            "remove_block",
            "place_block",
            "unplace_block",
            "move_block"
          ]
        },
        "block_id": { "type": "string" },
        "block": { "$ref": "#/$defs/GridViewBlock" },
        "area_id": { "type": "string", "default": "" },
        "index": { "type": "integer", "default": -1 }
      }
    },
    "A2UIPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ops": {
          "type": "array",
          "items": { "$ref": "#/$defs/A2UIPatchOp" },
          "default": []
        }
      }
    }
  }
}
