      {"name": "Losses", "value": 100, "color": "#ef4444"}
    ],
    "expect": {
      "chartType": "donut",
      "categories": [],
      "series": [],
      "slices": [
        {"label": "Revenue", "value": 1000.0, "color": "#10b981"},
        {"label": "Costs", "value": 300.0, "color": "#f59e0b"},
        {"label": "Losses", "value": 100.0, "color": "#ef4444"}
      ],
      "overlay": {"title": "Margin", "value": "+600", "tone": "green"}
    }
  },
  {
