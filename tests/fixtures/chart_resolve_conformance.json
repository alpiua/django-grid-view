  {
    "id": "stacked_bar_rows",
    "spec": {
      "id": "packages",
      "chart_type": "bar",
      "x_key": "name",
      "stacked": true,
      "tooltip_kind": "packages",
      "series": [
        {"key": "included", "label": "Included", "color": "#22c55e", "series_type": "bar"},
        {"key": "rejected", "label": "Rejected", "color": "#ef4444", "series_type": "bar"}
      ]
    },
    "rows": [
      {"name": "Pkg A", "included": 100, "rejected": 20, "_loss_mode": true},
      {"name": "Pkg B", "included": 80, "rejected": 10}
    ],
    "expect": {
      "chartType": "bar",
      "categories": ["Pkg A", "Pkg B"],
      "series": [
        {"name": "Included", "values": [0.0, 80.0], "color": "#22c55e"},
        {"name": "Rejected", "values": [20.0, 10.0], "color": "#ef4444"}
      ],
      "slices": []
    }
  },
