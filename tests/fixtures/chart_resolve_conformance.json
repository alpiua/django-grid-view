[
  {
    "id": "bar_multi_series",
    "spec": {
      "id": "finance",
      "chart_type": "bar",
      "x_key": "name",
      "series": [
        {"key": "revenue", "label": "Revenue", "color": "#22c55e", "series_type": "bar"},
        {"key": "expenses", "label": "Expenses", "color": "#ca8a04", "series_type": "bar"}
      ]
    },
    "rows": [
      {"name": "Cardio", "revenue": 1000, "expenses": 200},
      {"name": "Neuro", "revenue": "800", "expenses": "150"}
    ],
    "expect": {
      "chartType": "bar",
      "categories": ["Cardio", "Neuro"],
      "series": [
        {"name": "Revenue", "values": [1000.0, 800.0], "color": "#22c55e"},
        {"name": "Expenses", "values": [200.0, 150.0], "color": "#ca8a04"}
      ],
      "slices": []
    }
  },
  {
    "id": "donut_with_overlay",
    "spec": {
      "id": "margin",
      "chart_type": "donut",
      "label_key": "name",
      "value_key": "value",
      "overlay": {"title": "Margin", "value": "+600", "tone": "green"}
